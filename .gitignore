# Local Claude Code settings
.claude/settings.local.json

# claude-flow runtime state (local, not app code)
.claude-flow/

# graphify tool output (not part of the app)
graphify-out/

# Cloudflare Worker local secrets + cache
cloudflare-worker/.dev.vars
.wrangler/
cloudflare-worker/node_modules/
# Generated on demand via `pnpm cf-typegen` (wrangler types) — not vendored.
cloudflare-worker/worker-configuration.d.ts

# Electron host build output
desktop/out/
desktop/dist/

# Backend (axum) build
backend/target/

# Pinned Riot root CA is PUBLIC and required at runtime (CA pinning) — un-ignore.
!desktop/resources/riotgames.pem

# Seed refresh candidates (scripts/refresh-seeds.mjs output — curator reviews,
# then manually replaces the real seed; candidates are never committed)
*.candidate.json
