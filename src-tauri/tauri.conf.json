{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Champ Select Assistant",
  "version": "0.9.0",
  "identifier": "com.aslan.champ-select-assistant",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "champ-select-assistant",
        "width": 800,
        "height": 600,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; connect-src 'self' https://cdn.merakianalytics.com https://ddragon.leagueoflegends.com https://cdn.communitydragon.org; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Aslan Berkilic",
    "copyright": "Copyright © 2026 Aslan Berkilic",
    "shortDescription": "League of Legends champion select advisor",
    "longDescription": "AI-powered champion recommendations for your champion select phase using personal match history and live meta data.",
    "category": "Games",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "",
      "endpoints": [
        "https://github.com/Berkilic41/champ-select-assistant/releases/latest/download/latest.json"
      ]
    },
    "single-instance": null
  }
}
