{
  "name": "csa-desktop",
  "version": "0.10.0-beta.6",
  "private": true,
  "description": "Electron host for champ-select-assistant — Node I/O layer around the csa-core WASM engine (P1 migration).",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "build:wasm": "wasm-pack build --target nodejs ../core",
    "predist": "pnpm build:wasm",
    "predist:dir": "pnpm build:wasm",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "release": "pnpm build:wasm && electron-vite build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
