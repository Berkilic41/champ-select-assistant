    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.15.2",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
