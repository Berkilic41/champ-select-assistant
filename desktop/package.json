{
  "name": "csa-desktop",
  "version": "0.10.0-beta.1",
  "private": true,
  "description": "Electron host for champ-select-assistant — Node I/O layer around the csa-core WASM engine (P1 migration).",
  "type": "commonjs",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
